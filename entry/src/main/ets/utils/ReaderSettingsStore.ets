    settings.eyeTurnEnabled = await ReaderSettingsStore.getBoolean(
      store,
      ReaderSettingsStore.KEY_EYE_TURN_ENABLED,
      AppStorage.get<boolean>(ReaderSettingsStore.KEY_EYE_TURN_ENABLED) ?? false
