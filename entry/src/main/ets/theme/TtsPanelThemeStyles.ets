import { ThemeIds } from './ThemeModels';

/** Background of the TTS / audiobook player panel for one theme and mode. */
export class TtsPanelThemeStyle {
  // 720 x 520 scene anchored to the top of the panel, generated by
  // scripts/generate-tts-panel-backgrounds.py.
  artwork: Resource;
  // Sky colour behind the artwork; it blends into surfaceColor at the artwork's bottom edge.
  skyColor: string;
  // Opaque panel colour under the controls.
  surfaceColor: string;
  // Soft light behind the playback controls.
  glowColor: string;

  constructor(artwork: Resource, skyColor: string, surfaceColor: string, glowColor: string) {
    this.artwork = artwork;
    this.skyColor = skyColor;
    this.surfaceColor = surfaceColor;
    this.glowColor = glowColor;
  }
}

export class TtsPanelThemeStyles {
  static readonly ARTWORK_ASPECT_RATIO: number = 720 / 520;

