{
  "module": {
    "name": "entry_test",
    "type": "feature",
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "mainElement": "ComicColorTestAbility",
    "pages": "$profile:test_pages",
    "abilities": [
      {
        "name": "ComicColorTestAbility",
        "srcEntry": "./ets/testability/ComicColorTestAbility.ets",
        "startWindowIcon": "$media:layered_image",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      },
      {
        "name": "ReaderFontWeightTestAbility",
        "srcEntry": "./ets/testability/ReaderFontWeightTestAbility.ets",
        "startWindowIcon": "$media:layered_image",
        "startWindowBackground": "$color:start_window_background",
        "exported": false
      }
    ],
    "extensionAbilities": []
  }
}
